MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulseboard
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional, development only. Leave unset/false unless you hit a Windows-
# specific issue where Node's own DNS resolver fails to resolve the Atlas
# SRV record (querySrv ECONNREFUSED) despite `nslookup` succeeding for the
# same record. See README > Troubleshooting before enabling this.
MONGO_SRV_DNS_WORKAROUND=false
