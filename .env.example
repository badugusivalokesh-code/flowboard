# FlowBoard environment reference.
# Use server variables in server/.env and the client variable in client/.env.

# Server (server/.env)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowboard
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
# Optional during initial backend deployment. Set this to the exact frontend
# origin once the stable Vercel URL is known.
# CLIENT_URL=https://your-frontend.vercel.app
NODE_ENV=development
# Optional, development only. See server/.env.example and README.md.
MONGO_SRV_DNS_WORKAROUND=false

# Client (client/.env)
VITE_API_URL=http://localhost:5000/api
